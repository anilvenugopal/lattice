# Copy to .env and edit. Every setting has a working development default.
# All settings use the LATTICE_ prefix.
LATTICE_APP_NAME=Lattice
LATTICE_APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LATTICE_SECRET_KEY=change-me
# SQLite until step 2 of the architecture moves to Postgres (docs/adr/0001).
LATTICE_DATABASE_URL=sqlite:///./data/lattice.db
# The host the `lattice` command line runs: "module:attribute".
LATTICE_HOST=demo_host.main:app

# Logo for light and dark mode (URL paths or absolute URLs).
LATTICE_BRAND_LOGO_LIGHT=/static/brand/logo-light.svg
LATTICE_BRAND_LOGO_DARK=/static/brand/logo-dark.svg
# false when the logo images already include the application name (a wordmark)
LATTICE_BRAND_SHOW_NAME=true

LATTICE_SESSION_IDLE_MINUTES=480
LATTICE_SESSION_MAX_HOURS=24
# Secure cookie flag. Unset = on in production or over HTTPS.
# LATTICE_COOKIE_SECURE=true

LATTICE_PASSWORD_LOGIN_ENABLED=true

# OIDC (any standards-compliant provider: Entra ID, Okta, Keycloak, Auth0, Google).
# The sign-in button appears when LATTICE_OIDC_ISSUER and LATTICE_OIDC_CLIENT_ID are set.
LATTICE_OIDC_ISSUER=
LATTICE_OIDC_CLIENT_ID=
LATTICE_OIDC_CLIENT_SECRET=
LATTICE_OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
LATTICE_OIDC_SCOPES=openid email profile
LATTICE_OIDC_PROVIDER_LABEL=Single sign-on
# Role given to a new OIDC user on first sign-in. Empty = no role; an admin must approve.
LATTICE_OIDC_DEFAULT_ROLE=
# Link SSO sign-ins to existing accounts by email even without email_verified in the token.
# Entra ID does not send email_verified; set true only for your own single-tenant directory.
LATTICE_OIDC_TRUST_EMAIL=false
