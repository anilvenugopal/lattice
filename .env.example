# Copy to .env and edit. Every setting has a working development default.
APP_NAME=Lattice
APP_ENV=development
# Logo for light and dark mode (URL paths or absolute URLs). Put your files in app/static/brand/.
BRAND_LOGO_LIGHT=/static/brand/logo-light.svg
BRAND_LOGO_DARK=/static/brand/logo-dark.svg
# false when the logo images already include the application name (a wordmark)
BRAND_SHOW_NAME=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# SQLite by default. Postgres: postgresql+psycopg://user:pass@host/db (add the driver to pyproject)
DATABASE_URL=sqlite:///./data/app.db

SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
# Secure cookie flag. Unset = on in production or over HTTPS.
# COOKIE_SECURE=true

PASSWORD_LOGIN_ENABLED=true

# OIDC (any standards-compliant provider: Entra ID, Okta, Keycloak, Auth0, Google).
# Login button appears when OIDC_ISSUER and OIDC_CLIENT_ID are set.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_PROVIDER_LABEL=Single sign-on
# Role given to a new OIDC user on first sign-in. Empty = no role; an admin must approve.
OIDC_DEFAULT_ROLE=
# Link SSO sign-ins to existing accounts by email even without email_verified in the token.
# Entra ID does not send email_verified; set true only for your own single-tenant directory.
OIDC_TRUST_EMAIL=false
