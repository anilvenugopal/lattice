# Copy to .env and edit. Every setting has a working development default.
# LATTICE_* settings are Lattice's (all of them: Help › Developer › Reference › Settings);
# SHOWCASE_* settings are the showcase host's own (hosts/showcase/showcase_host/settings.py).
LATTICE_APP_NAME=Lattice
LATTICE_APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LATTICE_SECRET_KEY=change-me
# Postgres from compose.yaml (`make db-up`).
LATTICE_DATABASE_URL=postgresql+psycopg://lattice:lattice@127.0.0.1:5436/lattice
# The host the `lattice` command line runs: "module:attribute".
LATTICE_HOST=showcase_host.main:app

# Logo for light and dark mode (URL paths or absolute URLs).
LATTICE_BRAND_LOGO_LIGHT=/static/brand/logo-light.png
LATTICE_BRAND_LOGO_DARK=/static/brand/logo-dark.png
# false when the logo images already include the application name (a wordmark)
LATTICE_BRAND_SHOW_NAME=true

LATTICE_SESSION_IDLE_MINUTES=480
LATTICE_SESSION_MAX_HOURS=24
# Secure cookie flag. Unset = on in production or over HTTPS.
# LATTICE_COOKIE_SECURE=true

LATTICE_PASSWORD_LOGIN_ENABLED=true

# A grid query running longer than this many seconds is cancelled; the user is
# asked to narrow the search or filters.
LATTICE_GRID_QUERY_TIMEOUT_SECONDS=15

# OIDC (any standards-compliant provider: Entra ID, Okta, Keycloak, Auth0, Google).
# The sign-in button appears when LATTICE_OIDC_ISSUER and LATTICE_OIDC_CLIENT_ID are set.
LATTICE_OIDC_ISSUER=
LATTICE_OIDC_CLIENT_ID=
LATTICE_OIDC_CLIENT_SECRET=
LATTICE_OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
LATTICE_OIDC_SCOPES=openid email profile
LATTICE_OIDC_PROVIDER_LABEL=Single sign-on
# Role given to a new OIDC user on first sign-in. Empty = no role; an admin must approve.
LATTICE_OIDC_DEFAULT_ROLE=
# Link SSO sign-ins to existing accounts by email even without email_verified in the token.
# Entra ID does not send email_verified; set true only for your own single-tenant directory.
LATTICE_OIDC_TRUST_EMAIL=false

# Links in emails point here: the address people use to reach the site.
LATTICE_PUBLIC_URL=http://localhost:8000

# Email (notifications). With no host, emails are not sent: they are kept as "logged",
# readable in Administration › Email.
LATTICE_SMTP_HOST=
LATTICE_SMTP_PORT=587
LATTICE_SMTP_USERNAME=
LATTICE_SMTP_PASSWORD=
LATTICE_SMTP_STARTTLS=true
LATTICE_MAIL_FROM=Lattice <noreply@localhost>

# Attachments: the folder their files are kept in (back it up with the database), the largest
# file in MB, and the file types accepted.
LATTICE_FILES_DIR=var/files
LATTICE_ATTACHMENT_MAX_MB=25
# LATTICE_ATTACHMENT_TYPES=pdf,png,jpg,jpeg,gif,webp,heic,txt,csv,doc,docx,xls,xlsx,ppt,pptx,odt,ods,eml,msg,zip

# Mounted shares for the folder picker, as JSON: {"Claims share": "/mnt/claims"}.
# LATTICE_FOLDER_STORES={}

# ── The showcase host ──────────────────────────────────────────────────────────
# A SharePoint library in the folder picker, beside the sample share. Leave SITE empty for none.
# SITE: "host:/sites/name". LIBRARY: the document library's name (empty: the default one).
# ROOT: a folder inside the library to start at; people cannot browse above it (empty: all).
SHOWCASE_SHAREPOINT_SITE=
SHOWCASE_SHAREPOINT_LIBRARY=
SHOWCASE_SHAREPOINT_ROOT=
# The SharePoint app registration (Sites.Read.All to browse; write access to create folders).
SHOWCASE_M365_TENANT_ID=
SHOWCASE_M365_CLIENT_ID=
SHOWCASE_M365_CLIENT_SECRET=
